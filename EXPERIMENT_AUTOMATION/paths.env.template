# Copy to paths.env and adjust. Values are substituted into ${VAR} placeholders
# in configuration/*.yml.

# --- JMeter ------------------------------------------------------------------
# With jmeter.location: controller (the default) JMeter runs on THIS machine,
# so these two point at the local install. On Windows use jmeter.bat.
JMETER_BIN=C:/apache-jmeter-5.6.3/bin/jmeter.bat
JMETER_JAVA_HOME=C:/Program Files/Java/jdk-21

# Only used with jmeter.location: remote (a dedicated load driver).
JMETER_HOST=10.0.0.11
JMETER_BASE_DIR=/home/jmeter

# --- System under test --------------------------------------------------------
SUT_HOST=10.0.0.12
SUT_BASE_DIR=/home/sut

# Built once ON THE SUT from
# https://github.com/RETIT/opentelemetry-javaagent-extension  (mvn -DskipTests package)
SPRING_REST_SERVICE_JAR=/home/sut/spring-rest-service.jar
JAVA_BIN=/usr/lib/jvm/java-25-openjdk-amd64/bin/java

# eBPF jAgent source ON THIS CONTROLLER (shipped to the SUT and built there)
JAGENT_LOCAL_DIR=C:/Users/Admin/IdeaProjects/ebpf-jagent
# Where the source lands, and is compiled, ON THE SUT
# Must NOT be inside SUT_BASE_DIR: provisioning may wipe this directory, and
# an overlap would take the application jar with it.
JAGENT_REMOTE_DIR=/home/sut/ebpf-jagent-agent
# Must be the libjvm.so belonging to JAVA_BIN above.
JVM_LIB_PATH=/usr/lib/jvm/java-25-openjdk-amd64/lib/server/libjvm.so
